app.fermatcommerce.com
fermat-dashboard-app-dev.pages.dev

CSS
/* Fermat personal dark theme. Dynamic mode handles all other colors. */
html[data-darkreader-scheme="dark"] {
    --fermat-dark-canvas: #151b18 !important;
    --fermat-dark-panel: #1b221e !important;
    --fermat-dark-raised: #242d27 !important;
    --fermat-dark-border: #3f4b42 !important;
    --fermat-dark-text: #e6eae3 !important;
    --fermat-dark-muted: #b7c2b5 !important;
    --darkreader-bg--chakra-colors-creme-100: #151b18 !important;
    --darkreader-bg--chakra-colors-creme-200: #242d27 !important;
    --darkreader-bg--chakra-colors-creme-300: #303b33 !important;
    --darkreader-bg--chakra-colors-surface-white: #1b221e !important;
    --darkreader-bg--chakra-colors-surface-default-lightest: #1b221e !important;
    --darkreader-bg--chakra-colors-surface-default-lighter: #242d27 !important;
    --darkreader-bg--chakra-colors-surface-default-light: #242d27 !important;
    --darkreader-bg--chakra-colors-surface-default-base: #303b33 !important;
    --darkreader-bg--chakra-colors-surface-tertiary-light: #151b18 !important;
    --darkreader-bg--chakra-colors-surface-tertiary-base: #242d27 !important;
    --darkreader-text--chakra-colors-text-default-dark: #e6eae3 !important;
    --darkreader-text--chakra-colors-text-default-darker: #e6eae3 !important;
    --darkreader-text--chakra-colors-text-default-darkest: #e6eae3 !important;
    --darkreader-text--chakra-colors-text-default-base: #e6eae3 !important;
    --darkreader-text--chakra-colors-text-default-light: #b7c2b5 !important;
    --darkreader-text--chakra-colors-text-default-lighter: #b7c2b5 !important;
    --darkreader-text--chakra-colors-text-default-lightest: #b7c2b5 !important;
    --darkreader-border--chakra-colors-border-default-lightest: #3f4b42 !important;
    --darkreader-border--chakra-colors-border-default-light: #3f4b42 !important;
    --darkreader-border--chakra-colors-border-default-base: #3f4b42 !important;
    --darkreader-border--chakra-colors-border-default-dark: #3f4b42 !important;
    color-scheme: dark !important;
}

/* The styled island covers workspace briefs, artifacts, and Behavior Graph. */
html[data-darkreader-scheme="dark"] .cg-tangent {
    --cg-surface: #1b221e !important;
    --darkreader-bg--cg-surface: #1b221e !important;
    --cg-creme-50: #151b18 !important;
    --darkreader-bg--cg-creme-50: #151b18 !important;
    --cg-creme-100: #151b18 !important;
    --darkreader-bg--cg-creme-100: #151b18 !important;
    --cg-creme-200: #242d27 !important;
    --darkreader-bg--cg-creme-200: #242d27 !important;
    --cg-creme-300: #303b33 !important;
    --darkreader-bg--cg-creme-300: #303b33 !important;
    --cg-creme-500: #3f4b42 !important;
    --darkreader-bg--cg-creme-500: #3f4b42 !important;
    --cg-grey-100: #242d27 !important;
    --darkreader-bg--cg-grey-100: #242d27 !important;
    --cg-brief-toggle-bg: #242d27 !important;
    --darkreader-bg--cg-brief-toggle-bg: #242d27 !important;
    --cg-brief-version-bg: #242d27 !important;
    --darkreader-bg--cg-brief-version-bg: #242d27 !important;
    --cg-skeleton-sheen: rgb(183 194 181 / 12%) !important;
    --darkreader-bg--cg-skeleton-sheen: rgb(183 194 181 / 12%) !important;
    --cg-fg1: #e6eae3 !important;
    --darkreader-text--cg-fg1: #e6eae3 !important;
    --cg-fg2: #b7c2b5 !important;
    --darkreader-text--cg-fg2: #b7c2b5 !important;
    --cg-fg3: #a7b2a5 !important;
    --darkreader-text--cg-fg3: #a7b2a5 !important;
    --cg-fg4: #98a595 !important;
    --darkreader-text--cg-fg4: #98a595 !important;
    --cg-border-lightest: #3f4b42 !important;
    --darkreader-border--cg-border-lightest: #3f4b42 !important;
    --cg-border-light: #3f4b42 !important;
    --darkreader-border--cg-border-light: #3f4b42 !important;
    --cg-border-base: #3f4b42 !important;
    --darkreader-border--cg-border-base: #3f4b42 !important;
}

/* Keep portaled UI readable, including controls in Fermat 2.0 dashboards. */
html[data-darkreader-scheme="dark"] .chakra-modal__content,
html[data-darkreader-scheme="dark"] .chakra-drawer__content,
html[data-darkreader-scheme="dark"] .chakra-popover__content,
html[data-darkreader-scheme="dark"] .chakra-menu__menu-list,
html[data-darkreader-scheme="dark"] .chakra-tooltip {
    background-color: var(--fermat-dark-raised) !important;
    color: var(--fermat-dark-text) !important;
    border-color: var(--fermat-dark-border) !important;
}

html[data-darkreader-scheme="dark"] .chakra-input,
html[data-darkreader-scheme="dark"] .chakra-textarea,
html[data-darkreader-scheme="dark"] .chakra-select {
    background-color: var(--fermat-dark-panel) !important;
    color: var(--fermat-dark-text) !important;
}

/* Recharts: improve labels and tooltip chrome without recoloring data. */
html[data-darkreader-scheme="dark"] .recharts-cartesian-axis-tick-value,
html[data-darkreader-scheme="dark"] .recharts-polar-angle-axis-tick-value {
    fill: var(--fermat-dark-muted) !important;
}
html[data-darkreader-scheme="dark"] .recharts-cartesian-grid line {
    stroke: var(--fermat-dark-border) !important;
}
html[data-darkreader-scheme="dark"] .recharts-default-tooltip {
    background-color: var(--fermat-dark-raised) !important;
    border-color: var(--fermat-dark-border) !important;
    color: var(--fermat-dark-text) !important;
}
html[data-darkreader-scheme="dark"] .recharts-tooltip-label {
    color: var(--fermat-dark-text) !important;
}

/* Native widgets follow the page palette. Images, video, canvas and frames
   deliberately receive no blanket filter, inversion, or background rules. */
html[data-darkreader-scheme="dark"] body.chakra-ui-light {
    background-color: var(--fermat-dark-canvas) !important;
    color: var(--fermat-dark-text) !important;
}
html[data-darkreader-scheme="dark"] ::selection {
    background-color: #45634e !important;
    color: #f2f5ef !important;
}
