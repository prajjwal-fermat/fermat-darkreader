app.fermatcommerce.com
fermat-dashboard-app-dev.pages.dev
*.fermat-dashboard-app-dev.pages.dev

INVERT
svg[viewBox="0 0 89 35"]

CSS
/* Fermat personal dark theme. Dynamic mode handles all other colors. */
html[data-darkreader-scheme="dark"] {
    --fermat-dark-canvas: #181818 !important;
    --fermat-dark-panel: #202020 !important;
    --fermat-dark-raised: #2a2a2a !important;
    --fermat-dark-border: #404040 !important;
    --fermat-dark-text: #e6e6e6 !important;
    --fermat-dark-muted: #b9b9b9 !important;
    --darkreader-bg--chakra-colors-creme-100: #181818 !important;
    --darkreader-bg--chakra-colors-creme-200: #2a2a2a !important;
    --darkreader-bg--chakra-colors-creme-300: #333333 !important;
    --darkreader-bg--chakra-colors-surface-white: #202020 !important;
    --darkreader-bg--chakra-colors-surface-default-lightest: #202020 !important;
    --darkreader-bg--chakra-colors-surface-default-lighter: #2a2a2a !important;
    --darkreader-bg--chakra-colors-surface-default-light: #2a2a2a !important;
    --darkreader-bg--chakra-colors-surface-default-base: #333333 !important;
    --darkreader-bg--chakra-colors-surface-tertiary-light: #181818 !important;
    --darkreader-bg--chakra-colors-surface-tertiary-base: #2a2a2a !important;
    --darkreader-text--chakra-colors-text-default-dark: #e6e6e6 !important;
    --darkreader-text--chakra-colors-text-default-darker: #e6e6e6 !important;
    --darkreader-text--chakra-colors-text-default-darkest: #e6e6e6 !important;
    --darkreader-text--chakra-colors-text-default-base: #e6e6e6 !important;
    --darkreader-text--chakra-colors-text-default-light: #b9b9b9 !important;
    --darkreader-text--chakra-colors-text-default-lighter: #b9b9b9 !important;
    --darkreader-text--chakra-colors-text-default-lightest: #b9b9b9 !important;
    --darkreader-border--chakra-colors-border-default-lightest: #404040 !important;
    --darkreader-border--chakra-colors-border-default-light: #404040 !important;
    --darkreader-border--chakra-colors-border-default-base: #404040 !important;
    --darkreader-border--chakra-colors-border-default-dark: #404040 !important;
    color-scheme: dark !important;
}

/* The styled island covers workspace briefs, artifacts, and Behavior Graph. */
html[data-darkreader-scheme="dark"] .cg-tangent {
    --cg-surface: #202020 !important;
    --darkreader-bg--cg-surface: #202020 !important;
    --cg-creme-50: #181818 !important;
    --darkreader-bg--cg-creme-50: #181818 !important;
    --cg-creme-100: #181818 !important;
    --darkreader-bg--cg-creme-100: #181818 !important;
    --cg-creme-200: #2a2a2a !important;
    --darkreader-bg--cg-creme-200: #2a2a2a !important;
    --cg-creme-300: #333333 !important;
    --darkreader-bg--cg-creme-300: #333333 !important;
    --cg-creme-500: #404040 !important;
    --darkreader-bg--cg-creme-500: #404040 !important;
    --cg-grey-100: #2a2a2a !important;
    --darkreader-bg--cg-grey-100: #2a2a2a !important;
    --cg-brief-toggle-bg: #2a2a2a !important;
    --darkreader-bg--cg-brief-toggle-bg: #2a2a2a !important;
    --cg-brief-version-bg: #2a2a2a !important;
    --darkreader-bg--cg-brief-version-bg: #2a2a2a !important;
    --cg-skeleton-sheen: rgb(185 185 185 / 12%) !important;
    --darkreader-bg--cg-skeleton-sheen: rgb(185 185 185 / 12%) !important;
    --cg-fg1: #e6e6e6 !important;
    --darkreader-text--cg-fg1: #e6e6e6 !important;
    --cg-fg2: #b9b9b9 !important;
    --darkreader-text--cg-fg2: #b9b9b9 !important;
    --cg-fg3: #a6a6a6 !important;
    --darkreader-text--cg-fg3: #a6a6a6 !important;
    --cg-fg4: #949494 !important;
    --darkreader-text--cg-fg4: #949494 !important;
    --cg-border-lightest: #404040 !important;
    --darkreader-border--cg-border-lightest: #404040 !important;
    --cg-border-light: #404040 !important;
    --darkreader-border--cg-border-light: #404040 !important;
    --cg-border-base: #404040 !important;
    --darkreader-border--cg-border-base: #404040 !important;
}

/* Keep portaled UI readable, including controls in Fermat 2.0 dashboards. */
html[data-darkreader-scheme="dark"] .chakra-modal__content,
html[data-darkreader-scheme="dark"] .chakra-drawer__content,
html[data-darkreader-scheme="dark"] .chakra-popover__content,
html[data-darkreader-scheme="dark"] .chakra-menu__menu-list,
html[data-darkreader-scheme="dark"] .chakra-tooltip {
    background-color: var(--fermat-dark-raised) !important;
    color: var(--fermat-dark-text) !important;
    border-color: var(--fermat-dark-border) !important;
}

html[data-darkreader-scheme="dark"] .chakra-input,
html[data-darkreader-scheme="dark"] .chakra-textarea,
html[data-darkreader-scheme="dark"] .chakra-select {
    background-color: var(--fermat-dark-panel) !important;
    color: var(--fermat-dark-text) !important;
}

/* Recharts: improve labels and tooltip chrome without recoloring data. */
html[data-darkreader-scheme="dark"] .recharts-cartesian-axis-tick-value,
html[data-darkreader-scheme="dark"] .recharts-polar-angle-axis-tick-value {
    fill: var(--fermat-dark-muted) !important;
}
html[data-darkreader-scheme="dark"] .recharts-cartesian-grid line {
    stroke: var(--fermat-dark-border) !important;
}
html[data-darkreader-scheme="dark"] .recharts-default-tooltip {
    background-color: var(--fermat-dark-raised) !important;
    border-color: var(--fermat-dark-border) !important;
    color: var(--fermat-dark-text) !important;
}
html[data-darkreader-scheme="dark"] .recharts-tooltip-label {
    color: var(--fermat-dark-text) !important;
}

/* Native widgets follow the page palette. Images, video, canvas and frames
   deliberately receive no blanket filter, inversion, or background rules. */
html[data-darkreader-scheme="dark"] body.chakra-ui-light {
    background-color: var(--fermat-dark-canvas) !important;
    color: var(--fermat-dark-text) !important;
}
html[data-darkreader-scheme="dark"] ::selection {
    background-color: #444444 !important;
    color: #f2f2f2 !important;
}

html[data-darkreader-scheme="dark"] input::placeholder,
html[data-darkreader-scheme="dark"] textarea::placeholder {
    color: var(--fermat-dark-muted) !important;
    opacity: 1 !important;
}
